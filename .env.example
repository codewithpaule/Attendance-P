# Django
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
TIME_ZONE=Africa/Lagos

# Database (Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DB_NAME=ofeeee
DB_USER=ofeeee
DB_PASSWORD=your_password
DB_HOST=ep-xxx.region.aws.neon.tech
DB_PORT=5432

# WebAuthn
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_NAME=Ofeeee
WEBAUTHN_ORIGIN=https://yourdomain.com

# Preview deployment
IS_PREVIEW=False

# Vercel
BEHIND_VERCEL=True

# CSRF
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Jobs
JOBS_SECRET=generate-with:openssl rand -hex 32
JOB_TIME_BUDGET_SECONDS=25

# Backup
BACKUP_AGE_RECIPIENT=age1publickey

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
EMAIL_DAILY_BUDGET=90

# Attendance settings
QR_TOKEN_MAX_AGE_SECONDS=20
CHECKIN_WINDOW_MINUTES=15
HEADCOUNT_TOLERANCE=2
SPOT_CHECK_COUNT=3
LOCATION_RETENTION_DAYS=180
LOW_ACCURACY_M=100
NEW_CREDENTIAL_FLAG_HOURS=24
ENABLE_NETWORK_BURST_FLAG=False
